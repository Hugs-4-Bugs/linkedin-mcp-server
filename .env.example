# Environment configuration template — copy to .env (gitignored) and fill locally.
# NEVER commit real secrets. Production values come from the secret manager, not a .env file.

# Required: which environment this process runs in: local | staging
# production is not established (owner decision D-A3).
ENVIRONMENT=local

# Server identity
SERVER_NAME=linkedin-mcp-server
SERVER_VERSION=0.1.0

# --- local -------------------------------------------------------------
# stdio mode needs nothing else. HTTP dev server binds loopback only:
HTTP_HOST=127.0.0.1
HTTP_PORT=3333

# --- LinkedIn OAuth (Milestone 2; leave unset in M1) ------------------
#LINKEDIN_CLIENT_ID=
#LINKEDIN_CLIENT_SECRET=
# Redirect URI(s), absolute HTTPS (no #), registered in the LinkedIn app:
#LINKEDIN_REDIRECT_URI=https://staging.example.com/linkedin/callback
# Scopes are fixed to the self-serve set and validated in code (ADR-012):
#   openid profile email w_member_social

# --- M5 persistent storage (optional; unset = in-memory M2-M4 behavior) ---
# Postgres (staging/production): postgres://user:pass@host:5432/db
# SQLite (local persistence + integration tests): sqlite:/path/to/file.db
#DATABASE_URL=sqlite:./dev.db

# --- M5 remote authentication (session auth via the /admin console) ---
# Session lifetime in seconds (default 8h).
#SESSION_TTL_SECONDS=28800
# HTTP request body cap, MiB (default 1).
#MAX_BODY_MIB=1
# Per-IP request rate limit per minute (default 120).
#HTTP_RATE_LIMIT_PER_MINUTE=120

# --- Publishing safety limits (Milestone 4; application-level, NOT LinkedIn quotas) ---
# Per-tenant daily publication budget (application safety limit; LinkedIn
# publishes no numeric quota — see ADR-015). Bounded 1..100.
#PUBLISH_DAILY_LIMIT=12
# How long identical post content is refused after an attempt (minutes).
#PUBLISH_DUPLICATE_WINDOW_MINUTES=10

# --- staging (Milestone 5) --------------------------------------------
#STAGING_PUBLIC_URL=https://mcp-staging.example.com
# Encryption key for token vault (KMS-managed in staging; local: dev-only key)
#TOKEN_VAULT_KEY=

# --- follow-up additions (issue #32: keys the code actually reads) -----
# Billing (hosted mode): enable server-side entitlement enforcement.
#BILLING_ENABLED=false
# Razorpay webhook secret (required only when BILLING_ENABLED=true).
#RAZORPAY_WEBHOOK_SECRET=
# Plan limits JSON: {"pro":{"toolCalls":5000}}
#BILLING_PLAN_LIMITS=
# Billing entitlement cache TTL seconds.
#BILLING_CACHE_TTL_SECONDS=300
# Auth mode: session | mock (local dev default mock).
#AUTH_MODE=mock
# OAuth provider: mock | real (real requires LinkedIn app credentials).
#OAUTH_PROVIDER=mock
# OAuth state TTL seconds (CSRF window).
#OAUTH_STATE_TTL_SECONDS=600
# Retention sweep interval seconds.
#RETENTION_SWEEP_INTERVAL_SECONDS=3600
# Audit log retention days.
#AUDIT_RETENTION_DAYS=90
# Session cookie name (must match any proxy/backend expectations).
#SESSION_COOKIE_NAME=lkm_session
# Trusted reverse-proxy IP: when set, X-Forwarded-For from THIS peer is
# used for per-client rate limiting (see deploy/Caddyfile).
#HTTP_TRUSTED_PROXY=
