# Staging env template — copy to deploy/.env (gitignored) and fill in.
# NEVER commit real values. Production additionally requires a secret
# manager; this file exists for staging/local-docker only.

# Public hostname the proxy serves (Caddy obtains TLS certs for it).
PUBLIC_HOSTNAME=staging.example.com

# Database
POSTGRES_PASSWORD=change-me-strong

# LinkedIn app credentials (owner action: create the app first — see
# 05_INTEGRATIONS/LINKEDIN_DEVELOPER_SETUP.md)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://staging.example.com/linkedin/callback

# Token vault master key: 32 bytes base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_VAULT_KEY=
