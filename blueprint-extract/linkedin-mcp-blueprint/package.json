{
  "name": "linkedin-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "LinkedIn MCP server for Claude and ChatGPT (self-serve compliant MVP)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "audit": "npm audit --omit=dev",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test && npm run audit",
    "start:stdio": "node dist/mcp/transport/stdio-entry.js",
    "start:http": "node dist/mcp/transport/http-entry.js",
    "scan:secrets": "bash scripts/secret-scan.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "24.19.4",
    "eslint": "10.15.0",
    "jiti": "^2.7.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}