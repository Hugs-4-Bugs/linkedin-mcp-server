# Workspace-local agent tooling lives under skills/, EXCEPT the three
# REPO-DISTRIBUTED Agent Skills (product deliverables, must be tracked).
# Pattern order matters: exclude the children first, then re-include dirs.
skills/*
!skills/linkedin-publishing/
!skills/linkedin-post-scheduling/
!skills/linkedin-connection-troubleshooting/
node_modules/

# M5 deployment secrets (never committed)
deploy/.env
deploy/caddy_data/

# Local environment secrets
.env
.env.*
!.env.example

# Build and test artifacts
dist/
coverage/
*.log

# Local database and runtime data
data/

# Temporary/generated files
graphify-out/
tmp/
